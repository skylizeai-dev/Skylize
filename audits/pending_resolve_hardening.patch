     _store(client, "anytype", "key-for-operator")
     resp = client.get("/api/v1/credentials/resolve", params={"provider": "anytype"}, headers=_OPERATOR)
-    assert resp.status_code == 200
-    assert resp.json()["value"] == "key-for-operator"
