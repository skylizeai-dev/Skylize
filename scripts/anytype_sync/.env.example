# Anytype Local API (Desktop app must be running)
ANYTYPE_API_KEY=your-anytype-api-key-here
ANYTYPE_BASE_URL=http://localhost:31009
ANYTYPE_SPACE_ID=your-space-id-here

# Skylize staging API
SKYLIZE_API_BASE_URL=https://your-skylize-instance.railway.app
SKYLIZE_WEBHOOK_SECRET=your-hmac-secret-here

# Optional: override default state file location
# SYNC_STATE_PATH=scripts/anytype_sync/.state/sync_state.json
