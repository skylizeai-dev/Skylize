# Skylize local config — copy to `.env` and fill in. `.env` is gitignored.
# Backend vars are prefixed SKYLIZE_ (loaded by config.py, env_prefix=SKYLIZE_).
# Real process env vars override .env values. The console BFF (website/) also has
# a few UNprefixed vars of its own — listed at the bottom for deployment / due-
# diligence visibility; their operational home is website/.env.local.example.

# Backend: "memory" (in-memory fakes, no infra) or "postgres" (asyncpg + Redis).
SKYLIZE_BACKEND=memory

# --- Guardrail policy engine (OPA) ---
# The Decision Engine evaluates every action against OPA. Fail-closed by
# contract: absence of an explicit allow is a denial (docs/04_decision_engine/
# guardrails.md §4). Local dev: the `opa` service in infra/docker-compose.yml
# serves the policy bundle (policy/) on :8181.
# NOTE: that bundle is currently a FAIL-CLOSED PLACEHOLDER — it denies everything
# until real per-class policy content is authored. Nothing can be approved yet.
SKYLIZE_OPA_URL=http://localhost:8181
# OPA data-API document the OPAClient queries. Default in config.py is the allow
# leaf `skylize/decision/allow`; the aggregate document that also carries
# deny_reasons is `skylize/decision`.
SKYLIZE_OPA_POLICY_PATH=skylize/decision/allow
# Per-request OPA timeout (seconds). On timeout the client fails closed (deny).
SKYLIZE_OPA_TIMEOUT_SECONDS=2.0

# --- LLM providers ---
# Set this to run the creative crew against real Claude instead of the demo
# adapter. Without it, agent execution uses the deterministic demo LLM.
SKYLIZE_ANTHROPIC_API_KEY=

# OpenAI key — used ONLY for knowledge-ingestion embeddings
# (text-embedding-3-small via memory/embedding_service.py). The pipeline
# activates when both this and SKYLIZE_QDRANT_URL are set; otherwise
# /api/v1/knowledge/ingest returns 503 and the rest of the app is unaffected.
SKYLIZE_OPENAI_API_KEY=

# --- Human user auth (JWT) ---
# Required when dev_auth is off. Leave dev_auth on for local; set a strong random
# secret before disabling it.
SKYLIZE_DEV_AUTH=true
SKYLIZE_JWT_SECRET=

# --- Credential vault (Fernet, urlsafe base64, 32 bytes) ---
# Leave blank for local (an ephemeral key is minted); set in prod so stored
# credentials survive a restart. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SKYLIZE_CREDENTIAL_ENCRYPTION_KEY=

# --- n8n bridge (agent-prompts endpoint) ---
SKYLIZE_N8N_API_KEY=

# HMAC-SHA256 secret for the inbound n8n knowledge-ingest webhook (X-Hub-Signature-256).
# REQUIRED: the /api/v1/knowledge/ingest endpoint fails closed (503) when unset.
SKYLIZE_KNOWLEDGE_WEBHOOK_SECRET=

# ============================================================================
# Console BFF (website/) — NOT read by this backend.
# The Next.js console reads these from its OWN process env (operational home:
# website/.env.local.example). They are surfaced here only so a deployment or
# due-diligence review of .env.example sees the full n8n surface (audit 3aa2bed3
# flagged that the OUTBOUND n8n admin creds were invisible here). Never put real
# values in this file.
# ============================================================================
# Outbound n8n admin credentials the BFF presents to n8n's public REST API to
# create/activate/delete workflows. e.g. N8N_API_URL=https://skylize.app.n8n.cloud
N8N_API_URL=
N8N_API_KEY=
# Default-OFF master switch for that workflow-admin route. Unset / not "true" =>
# the route returns 501 and never reaches n8n. That surface is ungoverned
# (session cookie only, no GovernanceToken / Decision-Engine gate) and dormant,
# so it is gated off pending a governed rewrite. Set "true" only in a controlled
# context where the raw, ungoverned admin path is acceptable.
SKYLIZE_ENABLE_N8N_ADMIN=
