# Skylize local config — copy to `.env` and fill in. `.env` is gitignored.
# Backend vars are prefixed SKYLIZE_ (loaded by config.py, env_prefix=SKYLIZE_).
# Real process env vars override .env values. The console BFF (website/) also has
# a few UNprefixed vars of its own — listed at the bottom for deployment / due-
# diligence visibility; their operational home is website/.env.local.example.

# Backend: "memory" (in-memory fakes, no infra) or "postgres" (asyncpg + Redis).
# Anything other than "memory" arms the two boot interlocks below
# (SKYLIZE_DEV_AUTH and SKYLIZE_DB_APP_URL): the process REFUSES TO START unless
# both are set correctly, because each of them silently disables a security
# guarantee while every request still succeeds.
SKYLIZE_BACKEND=memory

# --- Database (asyncpg) ---
# TWO DSNs BY PRIVILEGE. They are not interchangeable.
#   SKYLIZE_DB_URL     — the table-OWNING role. Used ONLY for migrations and
#                        extension setup. It bypasses every RLS policy.
#   SKYLIZE_DB_APP_URL — the non-superuser `skylize_app` role created by
#                        migration 0003. This is what the RUNTIME connects as,
#                        and the only reason tenant isolation applies at all.
# THE PROCESS REFUSES TO START on a non-memory backend when SKYLIZE_DB_APP_URL
# is empty or identical to SKYLIZE_DB_URL: empty makes the runtime fall back to
# the owning role, and a table owner bypasses RLS regardless of FORCE ROW LEVEL
# SECURITY (migrations/versions/0003_app_role_rls_subject.py:7-12). The check is
# a raw string comparison, so it catches the copy-paste case but CANNOT catch
# two different spellings of the same superuser DSN (host vs 127.0.0.1, an added
# query parameter, a password moved to .pgpass). Confirm the role, not the string:
#   psql "$SKYLIZE_DB_APP_URL" -c "select current_user, usesuper from pg_user where usename = current_user"
SKYLIZE_DB_URL=
SKYLIZE_DB_APP_URL=

# Password for the `skylize_app` role, read by migration 0003 AT MIGRATION TIME
# (os.environ, not Settings -- alembic does not construct Settings). On a FRESH
# database, leaving this empty creates skylize_app as a bare `LOGIN` with NO
# password (0003_app_role_rls_subject.py:49-50); the DSN in SKYLIZE_DB_APP_URL
# then cannot authenticate and the app fails at connect.
# IT MUST EQUAL THE PASSWORD EMBEDDED IN SKYLIZE_DB_APP_URL. Nothing checks that
# they agree -- a mismatch surfaces only as an authentication failure at boot.
# Not required against a database where skylize_app already exists: 0003 is
# idempotent and its ALTER branch does not reset an existing password.
SKYLIZE_APP_DB_PASSWORD=

# --- Redis (event bus, run ledger, governance broadcast) ---
SKYLIZE_REDIS_URL=

# --- Governance signing key (ECDSA P-384, PKCS8 PEM) ---
# REQUIRED on a non-memory backend: startup fails closed when empty
# (app/governance/keys.py). On the memory backend an EPHEMERAL key is minted per
# process with a WARNING — which breaks token verification across instances, so
# it is never acceptable in a deployment. Generate: python scripts/gen_governance_key.py
SKYLIZE_GOVERNANCE_SIGNING_KEY_PEM=

# --- CORS allow-list for browser origins ---
# Empty (default) = the middleware is not installed, which is correct while the
# gateway is a pure BFF. Set a JSON array to enable it. "*" is REFUSED at boot:
# the gateway sends credentialed responses, and a wildcard origin with
# credentials is a token leak.
# e.g. SKYLIZE_CORS_ORIGINS=["https://console.skylize.com"]
SKYLIZE_CORS_ORIGINS=

# --- Decision Engine ---
# Which engine the composition root wires. "inline" is the only value the API
# process accepts today; "opa" is refused at boot until real Rego and a live OPA
# server land (bootstrap.py). The OPA worker refuses anything but "opa", so the
# two can never both emit terminal decision.* events.
SKYLIZE_DECISION_ENGINE=inline
# org_ids the synchronous decision gate applies to, as a JSON array. Empty leaves
# the engine wired but idle — an org NOT listed here executes agents with the
# gate dormant. Adding a tenant is a process restart today.
# e.g. SKYLIZE_DECISION_ENGINE_ORG_IDS=["org_acme"]
SKYLIZE_DECISION_ENGINE_ORG_IDS=

# --- Rate limiting (per org, per 60s window; in-process, so the effective
# limit multiplies by worker/replica count) ---
SKYLIZE_RATE_LIMIT_PER_MINUTE=120
SKYLIZE_CREDENTIAL_RESOLVE_RATE_PER_MINUTE=10

# --- Guardrail policy engine (OPA) ---
# The Decision Engine evaluates every action against OPA. Fail-closed by
# contract: absence of an explicit allow is a denial (docs/04_decision_engine/
# guardrails.md §4). Local dev: the `opa` service in infra/docker-compose.yml
# serves the policy bundle (policy/) on :8181.
# NOTE: that bundle is currently a FAIL-CLOSED PLACEHOLDER — it denies everything
# until real per-class policy content is authored. Nothing can be approved yet.
SKYLIZE_OPA_URL=http://localhost:8181
# OPA data-API document the OPAClient queries. This MUST be the package/object
# path `skylize/decision` (the code default in decision_engine/config.py), which
# returns the whole package document {allow, require_human, deny, policy_version}
# that OPAClient parses as an object. The `.../allow` leaf returns only the bare
# boolean and drops deny_reasons - it is the wrong path; do not use it.
SKYLIZE_OPA_POLICY_PATH=skylize/decision
# Per-request OPA timeout (seconds). On timeout the client fails closed (deny).
SKYLIZE_OPA_TIMEOUT_SECONDS=2.0

# --- LLM providers ---
# Set this to run the creative crew against real Claude instead of the demo
# adapter. Without it, agent execution uses the deterministic demo LLM.
SKYLIZE_ANTHROPIC_API_KEY=

# OpenAI key — used ONLY for knowledge-ingestion embeddings
# (text-embedding-3-small via memory/embedding_service.py). The pipeline
# activates when both this and SKYLIZE_QDRANT_URL are set; otherwise
# /api/v1/knowledge/ingest returns 503 and the rest of the app is unaffected.
SKYLIZE_OPENAI_API_KEY=

# --- Human user auth (JWT) ---
# SKYLIZE_DEV_AUTH=true trusts the X-Dev-Org / X-Dev-User / X-Dev-Roles headers
# VERBATIM (src/skylize/edge/auth.py:39-50): any caller asserts any org and any
# role, and nothing is verified. That is a local convenience, not authentication.
# THE PROCESS REFUSES TO START with dev auth on and SKYLIZE_BACKEND set to
# anything but "memory". Leave it true only for the in-memory local run.
SKYLIZE_DEV_AUTH=true
# Required once dev auth is off (HS256, signs the access/refresh pair). Startup
# fails closed when dev auth is false and this is empty. Generate a strong random
# value: python -c "import secrets; print(secrets.token_urlsafe(48))"
SKYLIZE_JWT_SECRET=

# --- Credential vault (Fernet, urlsafe base64, 32 bytes) ---
# REQUIRED once SKYLIZE_BACKEND is anything but "memory": startup fails closed
# when it is empty. Blank is allowed only on the in-memory backend, which mints
# an ephemeral key and discards the credential rows at process exit anyway.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Then hold it as a real secret (deployment secret store, not this file) and do
# not rotate it casually -- losing it is losing every stored credential, and a
# changed key surfaces as "decryption failed" on every existing row.
SKYLIZE_CREDENTIAL_ENCRYPTION_KEY=

# --- n8n bridge (agent-prompts endpoint) ---
SKYLIZE_N8N_API_KEY=

# HMAC-SHA256 secret for the inbound n8n knowledge-ingest webhook (X-Hub-Signature-256).
# REQUIRED: the /api/v1/knowledge/ingest endpoint fails closed (503) when unset.
SKYLIZE_KNOWLEDGE_WEBHOOK_SECRET=

# ============================================================================
# Console BFF (website/) — NOT read by this backend.
# The Next.js console reads these from its OWN process env (operational home:
# website/.env.local.example). They are surfaced here only so a deployment or
# due-diligence review of .env.example sees the full n8n surface (audit 3aa2bed3
# flagged that the OUTBOUND n8n admin creds were invisible here). Never put real
# values in this file.
# ============================================================================
# Outbound n8n admin credentials the BFF presents to n8n's public REST API to
# create/activate/delete workflows. e.g. N8N_API_URL=https://skylize.app.n8n.cloud
N8N_API_URL=
N8N_API_KEY=
# Default-OFF master switch for that workflow-admin route. Unset / not "true" =>
# the route returns 501 and never reaches n8n. That surface is ungoverned
# (session cookie only, no GovernanceToken / Decision-Engine gate) and dormant,
# so it is gated off pending a governed rewrite. Set "true" only in a controlled
# context where the raw, ungoverned admin path is acceptable.
SKYLIZE_ENABLE_N8N_ADMIN=
