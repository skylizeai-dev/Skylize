# Skylize console BFF — copy to `.env.local` and fill in. `.env.local` is gitignored.
#
# Every var here is read ONLY on the server (route handlers / proxy).
# SKYLIZE_SERVICE_API_KEY is SERVER-ONLY: it must NEVER be renamed with a
# NEXT_PUBLIC_ prefix or referenced from any client component — doing either
# ships the backend key to every browser.

# Base URL of the Skylize backend (the Railway deployment).
# e.g. https://skylize-backend.up.railway.app — no trailing slash.
SKYLIZE_BACKEND_URL=

# Service API key the BFF presents to the backend (the issued "sky." key).
# SERVER-ONLY. Never NEXT_PUBLIC_. Never fetched from the browser.
SKYLIZE_SERVICE_API_KEY=

# Interim single-owner passphrase checked by POST /api/console/session.
# Replaced wholesale when the console moves to OIDC.
SKYLIZE_CONSOLE_PASSWORD=

# Secret used to sign the httpOnly "skylize_console" session cookie.
# Long random string; rotate to invalidate all sessions.
SKYLIZE_CONSOLE_SESSION_SECRET=

# n8n bridge for the console workflow builder (app/api/console/workflows).
# Optional — the route answers 503 "not configured" while these are unset.
# N8N_API_URL: instance base URL, e.g. https://skylize.app.n8n.cloud
# N8N_API_KEY: an n8n API key (n8n → Settings → n8n API)
N8N_API_URL=
N8N_API_KEY=

# Master switch for the n8n workflow-admin route (create/activate/delete).
# DEFAULT OFF: unset/anything-but-"true" → the route returns 501 and never
# reaches n8n. That surface is ungoverned (session cookie only, no
# GovernanceToken / Decision-Engine gate — audit 3aa2bed3) and dormant, so it is
# disabled pending a governed rewrite. Set to "true" ONLY in a controlled
# context where you accept the raw, ungoverned admin path.
SKYLIZE_ENABLE_N8N_ADMIN=

# Resend for the marketing-site contact form (app/api/contact).
# Optional — the route answers 503 "not configured" while these are unset.
# RESEND_API_KEY: from https://resend.com/api-keys
# CONTACT_FROM_EMAIL: must be a verified sender/domain in Resend
# CONTACT_TO_EMAIL: inbox that receives contact form submissions
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
